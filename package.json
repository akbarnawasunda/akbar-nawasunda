{
  "name": "akbar-nawasunda-site",
  "version": "0.1.0",
  "private": true,
  "description": "Official website foundation for Akbar Nawasunda (electronic music producer, remixer, DJ).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run assets:check && npm run typecheck && npm run lint && npm run test && npm run test:db && npm run build",
    "assets:check": "node scripts/check-assets.mjs",
    "test": "tsx --test \"tests/studio/*.test.ts\" \"tests/components/*.test.ts\"",
    "studio:hash-password": "tsx scripts/studio-hash-password.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx drizzle/seed.ts",
    "test:db": "node --conditions=react-server --import tsx --test \"tests/database/*.test.ts\""
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
