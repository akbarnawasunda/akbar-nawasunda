{
  "name": "akbar-nawasunda-site",
  "version": "0.1.0",
  "private": true,
  "description": "Official website foundation for Akbar Nawasunda (electronic music producer, remixer, DJ).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "NEXT_PUBLIC_BUILD_REV=$(git rev-parse --short HEAD 2>/dev/null || echo local) next build",
    "start": "next start -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run assets:check && npm run typecheck && npm run lint && npm run test && npm run test:db && npm run build",
    "assets:check": "node scripts/check-assets.mjs",
    "covers:fetch": "tsx scripts/fetch-release-artwork.mjs",
    "covers:sleeves": "tsx scripts/generate-placeholder-covers.mjs",
    "test": "tsx --test \"tests/studio/*.test.ts\"",
    "studio:hash-password": "tsx scripts/studio-hash-password.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx drizzle/seed.ts",
    "test:db": "node --conditions=react-server --import tsx --test \"tests/database/*.test.ts\"",
    "a11y": "node scripts/a11y-audit.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "lighthouse": "npx --yes lighthouse@12 --preset=desktop --chrome-flags=\"--headless=new --no-sandbox\"",
    "check:web": "node scripts/check-web.mjs",
    "check:web:external": "node scripts/check-web.mjs --external",
    "covers:plan": "tsx scripts/fetch-release-artwork.mjs --dry-run",
    "qa:motion": "node scripts/qa-motion.mjs",
    "perf:audit": "node scripts/perf-audit.mjs",
    "audit:tokens": "node scripts/token-audit.mjs",
    "review:shots": "node scripts/review/shots.mjs",
    "audit:fonts": "node scripts/font-audit.mjs",
    "visual:setup": "bash scripts/setup-visual-tools.sh",
    "visual:check": "node scripts/visual-check.mjs",
    "qa:copy": "node scripts/qa-copy.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "lenis": "^1.3.27",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "axe-core": "^4.14.0",
    "d3-contour": "^4.0.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "puppeteer-core": "^25.16.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
