  "description": "Official website foundation for Akbar Nawasunda (electronic music producer, remixer, DJ).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
