# dependencies
node_modules/

# next.js build output
.next/
out/
build/

# misc
.DS_Store
*.pem
npm-debug.log*
*.tsbuildinfo

# env files (secrets never committed; copy .env.example instead)
.env
.env*.local

# vercel / deploy metadata
.vercel

# Local playwright / screenshot artefacts. Everything in here is scratch space except the review
# screenshots, which the Review shots workflow commits so the owner can look at them without a token
# (round 40: they used to live in public/, which meant 6.8 MB of QA PNGs were served from production).
/artifacts/*
!/artifacts/review-shots/
/.playwright-cli/

# local database for NAWA STUDIO development (never commit)
/data/

# local screenshot harness output (kept out of git)
/.review/
