# Copy to .env.local (gitignored) for local development. Never commit real values.

# Canonical public URL of the site (used for metadata / Open Graph).
# Leave unset in local development.
# NEXT_PUBLIC_SITE_URL=

# NAWA STUDIO (see docs/nawa-studio.md)
# Local development: file:./data/studio.db (no auth token needed)
# Production: libsql://<your-database>.turso.io  (requires DATABASE_AUTH_TOKEN)
#
# These two names are what the code reads. The older TURSO_* spelling is also accepted for the same
# database (src/lib/turso.ts, D-014 + D-028). Set ONE pair, not both:
#
#   TURSO_DATABASE_URL=
#   TURSO_AUTH_TOKEN=
DATABASE_URL=
# Required only when DATABASE_URL is a libsql:// URL.
DATABASE_AUTH_TOKEN=
# Generate with: npm run -s studio:hash-password  (password is read from stdin)
STUDIO_ADMIN_PASSWORD_HASH=
